# ─────────────────────────────────────────────────────────────
# LiRa environment configuration. Copy to `.env` and fill in.
# NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

# --- Core ---
APP_NAME=LiRa
ENVIRONMENT=development            # development | production
APP_BASE_URL=http://localhost      # public URL used in emails/invite links
LOG_LEVEL=INFO

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-generate-a-long-random-value
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14
# Cookies: set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=false
COOKIE_DOMAIN=
# Comma-separated origins allowed by CORS (frontend dev origin)
CORS_ORIGINS=http://localhost,http://localhost:3000

# --- Database ---
POSTGRES_USER=lira
POSTGRES_PASSWORD=lira_password_change_me
POSTGRES_DB=lira
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full URL is derived from the parts above by the backend, but can be overridden:
# DATABASE_URL=postgresql+asyncpg://lira:lira_password_change_me@postgres:5432/lira

# --- File storage ---
UPLOAD_ROOT=/data/uploads
MAX_UPLOAD_SIZE_MB=25

# --- Email (SMTP) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=LiRa <no-reply@lira.local>
# If SMTP_HOST is empty, emails are logged to the console instead of sent.

# --- Auth limits ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
INVITATION_EXPIRE_HOURS=72
PASSWORD_RESET_EXPIRE_HOURS=2

# Per-IP throttle on auth endpoints (complements the per-account lockout above)
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# --- Activity feed retention ---
# Only the newest N activity events are kept; older ones are deleted as new ones
# arrive. The audit log is separate and never pruned.
ACTIVITY_RETENTION_LIMIT=100

# --- Background jobs ---
# Daily scan that emails assignees about issues due soon / overdue.
# Runs in-process; keep a single backend replica (or add a leader lock) if scaling out.
DUE_REMINDER_ENABLED=true
DUE_REMINDER_INTERVAL_HOURS=24

# --- Frontend (build/runtime) ---
NEXT_PUBLIC_API_BASE_URL=/api
# Optional explicit WebSocket URL for live updates. Leave blank to use the same
# origin (works behind the reverse proxy); the client falls back automatically
# when the frontend is hit directly on :3000 in development.
# NEXT_PUBLIC_WS_URL=

# --- Optional: Slack (future) ---
SLACK_WEBHOOK_URL=
